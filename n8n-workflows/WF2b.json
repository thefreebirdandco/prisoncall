      "id": "a19e72d2-1c95-44bc-b14b-7b3ecda51429",
      "name": "Get Subscription for DID",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-576, 256]
    },
    {
      "parameters": {
        "jsCode": "const extracted = $('Verify HMAC Seal Succeeded').first().json;\nconst sub = $input.first().json[0] || {};\n\nconst did = sub.current_did || '';\nlet didDisplay = did;\nif (did.startsWith('61') && did.length === 11) {\n  const local = '0' + did.substring(2);\n  didDisplay = local.replace(/(\\d{2})(\\d{4})(\\d{4})/, '$1 $2 $3');\n}\n\nconst assignedMobile = sub.assigned_mobile || '';\nconst assignedMobileE164 = assignedMobile ? ('+' + assignedMobile) : (extracted.customer_mobile_e164 || '');\nlet assignedMobileDisplay = '';\nif (assignedMobile.length === 11 && assignedMobile.startsWith('61')) {\n  const local = '0' + assignedMobile.substring(2);\n  assignedMobileDisplay = local.replace(/(\\d{4})(\\d{3})(\\d{3})/, '$1 $2 $3');\n}\n\nreturn [{\n  json: {\n    ...extracted,\n    current_did: did,\n    did_display: didDisplay,\n    prison_name: sub.prison_name || '',\n    assigned_mobile: assignedMobile,\n    assigned_mobile_e164: assignedMobileE164,\n    assigned_mobile_display: assignedMobileDisplay\n  }\n}];"
      },
