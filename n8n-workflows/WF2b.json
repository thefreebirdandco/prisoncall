    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst smsText = (body.Body || '').trim().toUpperCase();\nconst fromNumber = (body.From || '').replace(/[\\s\\-]/g, '');\n\nif (smsText !== 'YES') return [];\n\nlet mobile = fromNumber;\nif (mobile.startsWith('+61')) mobile = mobile.substring(1);\n\nreturn [{\n  json: {\n    mobile_for_lookup: mobile,\n    from_number_e164: fromNumber\n  }\n}];"
      },
