    {
      "parameters": {
        "jsCode": "const subsArray = $input.first().json;\nconst sub = Array.isArray(subsArray) ? (subsArray[0] || null) : null;\nif (!sub || !sub.seal_subscription_id) return [];\n\nconst checkYesSms = $('Check YES SMS').first().json;\nreturn [{\n  json: {\n    ...sub,\n    mobile_for_lookup: checkYesSms.mobile_for_lookup,\n    from_number_e164: checkYesSms.from_number_e164\n  }\n}];"
      },
