        "subject": "={{ 'PAYMENT CLEARED - ' + $('Merge DID Succeeded').first().json.customer_name + ' - Action Required' }}",
        "bodyContent": "={{ '<h2>Payment Cleared \u2014 Action Required</h2><p>The failed payment for this subscriber has cleared. You must now:</p><ol><li><strong>Resume the VoipLine DID licence</strong> for this subscriber.</li><li><strong>Open the admin portal \u2192 find this subscriber \u2192 click Resume Account.</strong> This will automatically notify the customer that their number is active again.</li></ol><table style=\"border-collapse:collapse;width:100%\"><tr><td style=\"padding:8px;border:1px solid #ddd\"><strong>Customer</strong></td><td style=\"padding:8px;border:1px solid #ddd\">' + $('Merge DID Succeeded').first().json.customer_name + '</td></tr><tr><td style=\"padding:8px;border:1px solid #ddd\"><strong>Email</strong></td><td style=\"padding:8px;border:1px solid #ddd\">' + $('Merge DID Succeeded').first().json.customer_email + '</td></tr><tr><td style=\"padding:8px;border:1px solid #ddd\"><strong>Assigned Mobile</strong></td><td style=\"padding:8px;border:1px solid #ddd\">' + $('Merge DID Succeeded').first().json.assigned_mobile_display + '</td></tr><tr><td style=\"padding:8px;border:1px solid #ddd\"><strong>DID (display)</strong></td><td style=\"padding:8px;border:1px solid #ddd\">' + $('Merge DID Succeeded').first().json.did_display + '</td></tr><tr><td style=\"padding:8px;border:1px solid #ddd\"><strong>DID (VoipLine copy)</strong></td><td style=\"padding:8px;border:1px solid #ddd\">' + $('Merge DID Succeeded').first().json.current_did + '</td></tr><tr><td style=\"padding:8px;border:1px solid #ddd\"><strong>Prison</strong></td><td style=\"padding:8px;border:1px solid #ddd\">' + $('Merge DID Succeeded').first().json.prison_name + '</td></tr></table>' }}",
