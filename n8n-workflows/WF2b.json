      "id": "227e1dfc-6979-41a6-8292-ea1c33fdf119",
      "name": "Seal Process Charge",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-80, -208]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst header = $input.first().json.headers['x-seal-hmac-sha256'];\nconst crypto = require('crypto');\nconst secret = $vars.PRISONCALL_SEAL_API_SECRET;\nconst computed = crypto.createHmac('sha256', secret).update(JSON.stringify(body)).digest('hex');\nif (header !== computed) throw new Error('HMAC verification failed');\n\nconst ba = body.billing_attempt || body;\nconst sub = ba.subscription || {};\nconst customer = sub.customer || {};\n\nlet mobile = (customer.phone || customer.mobile || '').replace(/[\\s\\-]/g, '');\nif (mobile.startsWith('+61')) mobile = mobile.substring(1);\nelse if (mobile.startsWith('0')) mobile = '61' + mobile.substring(1);\n\nconst mobileLocal = '0' + mobile.substring(2);\nconst mobileDisplay = mobileLocal.replace(/(\\d{4})(\\d{3})(\\d{3})/, '$1 $2 $3');\n\nreturn [{\n  json: {\n    seal_subscription_id: String(sub.id || ba.subscription_id || ''),\n    customer_name: ((customer.first_name || '') + ' ' + (customer.last_name || '')).trim(),\n    customer_email: customer.email || '',\n    customer_mobile: mobile,\n    customer_mobile_display: mobileDisplay,\n    customer_mobile_e164: '+' + mobile\n  }\n}];"
      },
